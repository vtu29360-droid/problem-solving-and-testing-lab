class Solution {
    public String dayOfTheWeek(int day, int month, int year) {

        String[] week = {
            "Sunday", "Monday", "Tuesday",
            "Wednesday", "Thursday", "Friday", "Saturday"
        };

        int[] days = {
            31, 28, 31, 30, 31, 30,
            31, 31, 30, 31, 30, 31
        };

        int totalDays = 0;

        // Count days in previous years
        for (int y = 1971; y < year; y++) {
            if (isLeap(y))
                totalDays += 366;
            else
                totalDays += 365;
        }

        // Count days in previous months
        for (int m = 1; m < month; m++) {
            totalDays += days[m - 1];

            if (m == 2 && isLeap(year))
                totalDays++;
        }

        // Add days before the given day
        totalDays += day - 1;

        // 1971 Jan 1 was Friday
        int index = (5 + totalDays) % 7;

        return week[index];
    }

    public boolean isLeap(int year) {
        return (year % 400 == 0) ||
               (year % 4 == 0 && year % 100 != 0);
    }
}
        
    
